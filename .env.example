# Database
# Local dev (SQLite):
DATABASE_URL="file:./dev.db"

# Hostinger production (matches Deployments panel):
# DATABASE_URL="file:./prisma/prod.db"

# Or PostgreSQL (recommended later for large Excel imports):
# DATABASE_URL="postgresql://user:password@host:5432/pawmart?schema=public"

# Auth — required in production (use the value already in Hostinger; never commit the real secret)
AUTH_SECRET="generate-a-secure-random-string-here"
AUTH_URL="https://www.vitanovaservices.com"

# Site
NEXT_PUBLIC_SITE_URL="https://www.vitanovaservices.com"
NEXT_PUBLIC_SITE_NAME="TFRC Vita Nova"

# WhatsApp (international format, no + sign)
NEXT_PUBLIC_WHATSAPP_PHONE="97455049229"

# Meta / Facebook Ads (optional)
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_META_APP_ID=""
META_DOMAIN_VERIFICATION=""

# Media storage: local | s3
MEDIA_STORAGE="local"
NODE_ENV="production"
PORT="3000"

# Optional: S3/R2 for production media uploads
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=
