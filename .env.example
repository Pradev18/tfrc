# Local / docs — production uses Neon Postgres (see env.tfrcwholesale.com.example)

# Production (Hostinger): Neon / Supabase / Hostinger Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Local Docker Postgres example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tfrc?schema=public"

AUTH_SECRET="generate-a-secure-random-string-here"
AUTH_URL="https://tfrcwholesale.com"

NEXT_PUBLIC_SITE_URL="https://tfrcwholesale.com"
NEXT_PUBLIC_SITE_NAME="TFRC Wholesale Services"
NEXT_PUBLIC_CONTACT_EMAIL="info@tfrcwholesale.com"

ADMIN_EMAIL_APPROVAL_REQUIRED="true"
ADMIN_PASSWORD_LOCKED="true"
LOGIN_APPROVAL_RECIPIENT="info@tfrcwholesale.com"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="info@tfrcwholesale.com"
SMTP_PASSWORD=""
SMTP_FROM="TFRC Wholesale Services <info@tfrcwholesale.com>"

NEXT_PUBLIC_WHATSAPP_PHONE="97455049229"
MEDIA_STORAGE="local"
TFRC_DATA_DIR="../tfrc-persistent"
NODE_ENV="production"
PORT="3000"
