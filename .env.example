# Database
# Local dev (SQLite):
DATABASE_URL="file:./dev.db"

# Netlify production (read-only bundled SQLite — commit prisma/prod.db):
# DATABASE_URL="file:./prisma/prod.db"

# Or PostgreSQL (recommended for admin writes in production):
# DATABASE_URL="postgresql://user:password@host:5432/pawmart?schema=public"

# Auth — required in production
AUTH_SECRET="generate-a-secure-random-string-here"
AUTH_URL="http://localhost:3000"

# Site — MUST be your real HTTPS domain in production (required for Meta ads & WhatsApp previews)
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_SITE_NAME="TFRC Vita Nova"

# WhatsApp (international format, no + sign) — used in Meta Click-to-WhatsApp ads
NEXT_PUBLIC_WHATSAPP_PHONE="97455049229"

# Meta / Facebook Ads
# Pixel ID from Meta Events Manager → Data Sources → Pixel
NEXT_PUBLIC_META_PIXEL_ID=""
# Optional: Facebook App ID (Business Settings → Apps)
NEXT_PUBLIC_META_APP_ID=""
# Domain verification code from Meta Business Settings → Brand Safety → Domains
META_DOMAIN_VERIFICATION=""

# Media storage: local | s3
MEDIA_STORAGE="local"

# Optional: S3/R2 for production media uploads
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=

# Optional analytics
# GA4_MEASUREMENT_ID=
