{
  "name": "pawmart-qatar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/ensure-prod-db.mjs && next build",
    "hostinger:build": "prisma generate && node scripts/ensure-prod-db.mjs && NODE_OPTIONS=--max-old-space-size=4096 next build",
