    "start": "node scripts/ensure-prod-db.mjs && next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:prepare-prod": "node scripts/prepare-prod-db.mjs",
    "netlify:build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "test": "vitest run"
  },
  "dependencies": {
