# REQUIRED — external Postgres (Neon free tier recommended)
# Create at https://console.neon.tech → New project → copy connection string
# Example: postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Keep uploads (images/PDFs) outside the wiped app folder
