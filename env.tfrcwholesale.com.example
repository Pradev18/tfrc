# Hostinger Node.js — https://tfrcwholesale.com
# Paste these in Hostinger → Deployments → Environment variables
# (Do NOT commit real AUTH_SECRET or SMTP_PASSWORD to git)
#
# Start command MUST be: npm start
# Build command: npm run build

DATABASE_URL=file:./prisma/prod.db
AUTH_SECRET=REPLACE-WITH-YOUR-EXISTING-HOSTINGER-AUTH-SECRET
AUTH_URL=https://tfrcwholesale.com
NEXT_PUBLIC_SITE_URL=https://tfrcwholesale.com
NEXT_PUBLIC_SITE_NAME=TFRC Wholesale Services
NEXT_PUBLIC_CONTACT_EMAIL=info@tfrcwholesale.com
ADMIN_EMAIL_APPROVAL_REQUIRED=true
LOGIN_APPROVAL_RECIPIENT=info@tfrcwholesale.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@tfrcwholesale.com
SMTP_PASSWORD=PASTE_HOSTINGER_MAILBOX_PASSWORD
SMTP_FROM="TFRC Wholesale Services <info@tfrcwholesale.com>"
NEXT_PUBLIC_WHATSAPP_PHONE=97455049229
MEDIA_STORAGE=local
NODE_ENV=production
PORT=3000

# Optional Meta ads (leave blank if unused)
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_META_APP_ID=
# META_DOMAIN_VERIFICATION=
