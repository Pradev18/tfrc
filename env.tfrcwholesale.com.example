DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
TFRC_DATA_DIR=../tfrc-persistent

# Cloudflare R2 (required for fast images that survive redeploys)
MEDIA_STORAGE=r2
R2_ACCOUNT_ID=PASTE_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=PASTE_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=PASTE_R2_SECRET_ACCESS_KEY
R2_BUCKET=tfrc-media
R2_PUBLIC_URL=https://media.tfrcwholesale.com

AUTH_SECRET=JX0Pioaw1Dco1lhM1rUXuGvqM0fgoG1RUY8j5pi5yb4=
AUTH_URL=https://tfrcwholesale.com

NEXT_PUBLIC_SITE_URL=https://tfrcwholesale.com
NEXT_PUBLIC_SITE_NAME=TFRC Wholesale Services
NEXT_PUBLIC_CONTACT_EMAIL=info@tfrcwholesale.com

ADMIN_EMAIL_APPROVAL_REQUIRED=true
ADMIN_PASSWORD_LOCKED=true
