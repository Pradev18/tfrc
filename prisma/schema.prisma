generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  // Single Neon Postgres — three schemas (proper ecommerce domains).
  // Hostinger redeploys never touch this data (only app code updates).
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "catalog", "activity"]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?
  roles        UserRole[]
  auditLogs    AuditLog[]
  importJobs   ImportJob[]
  loginApprovals LoginApproval[]
  @@schema("auth")
}

model LoginApproval {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestTokenHash String    @unique
  pollTokenHash    String
  grantTokenHash   String    @unique
  status           String    @default("PENDING")
  requesterIp      String?
  userAgent        String?
  expiresAt        DateTime
  approvedAt       DateTime?
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, status, createdAt])
  @@index([expiresAt])
  @@schema("auth")
}

model LoginThrottle {
  id              String   @id
  failures        Int      @default(0)
  windowStartedAt DateTime @default(now())
  lockedUntil     DateTime?
  updatedAt       DateTime @updatedAt

  @@index([lockedUntil])
  @@schema("auth")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  @@schema("auth")
}

model Permission {
  id          String           @id @default(cuid())
  action      String
  resource    String
  description String?
  roles       RolePermission[]

  @@unique([action, resource])
  @@schema("auth")
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@schema("auth")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@schema("auth")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
  @@index([createdAt])
  @@schema("auth")
}

enum EnvironmentStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
  @@schema("catalog")
}

model Environment {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  description      String?
  tagline          String?
  icon             String?
  logoUrl          String?
  status           EnvironmentStatus @default(ACTIVE)
  sortOrder        Int               @default(0)
  departmentSource String?
  theme            String            @default("{}")
  seo              String            @default("{}")
  navigation       String            @default("[]")
  homepage         String            @default("{}")
  settings         String            @default("{}")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  products         Product[]
  categories       Category[]
  banners          Banner[]
  homepageSections HomepageSection[]
  shopCategories   ShopCategory[]
  importJobs       ImportJob[]

  @@index([status, sortOrder])
  @@schema("catalog")
}

model ShopCategory {
  id            String      @id @default(cuid())
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  slug          String
  name          String
  keywords      String      @default("[]")
  imageUrl      String?
  sortOrder     Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([environmentId, slug])
  @@index([environmentId, sortOrder])
  @@schema("catalog")
}

model Category {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  description   String?
  imageUrl      String?
  parentId      String?
  parent        Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children      Category[]  @relation("CategoryHierarchy")
  environmentId String?
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  sortOrder     Int         @default(0)
  isActive      Boolean     @default(true)
  googlePath    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  products      Product[]   @relation("ProductCategory")
  subProducts   Product[]   @relation("ProductSubcategory")

  @@index([parentId])
  @@index([environmentId])
  @@index([isActive, sortOrder])
  @@schema("catalog")
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  @@schema("catalog")
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  createdAt DateTime     @default(now())
  products  ProductTag[]
  @@schema("catalog")
}

model Product {
  id               String                 @id @default(cuid())
  productId        String                 @unique
  sku              String                 @unique
  /** Optional Excel row number (item_no column) for catalogue sort order. */
  itemNo           Int?
  name             String
  slug             String                 @unique
  shortDescription String?
  description      String?
  environmentId    String?
  environment      Environment?           @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  categoryId       String?
  category         Category?              @relation("ProductCategory", fields: [categoryId], references: [id])
  subcategoryId    String?
  subcategory      Category?              @relation("ProductSubcategory", fields: [subcategoryId], references: [id])
  brandId          String?
  brand            Brand?                 @relation(fields: [brandId], references: [id])
  status           ProductStatus          @default(ACTIVE)
  condition        String                 @default("new")
  gtin             String?
  weight           String?
  dimensions       String?
  shippingInfo     String?
  isFeatured       Boolean                @default(false)
  isBestseller     Boolean                @default(false)
  isNew            Boolean                @default(false)
  googleCategory   String?
  fbCategory       String?
  departmentSource String?
  /** Exclusive storefront shop-category bucket (slug). Null = More to explore / unassigned. */
  shopCategorySlug String?
  /** Shared key for separate catalogue rows that are size variants of one item. */
  variantGroupKey  String?
  /** Shopper-facing option such as S, M, L or XL. */
  variantLabel     String?
  /** Only the primary row appears as a catalogue card; siblings are selectable variants. */
  isVariantPrimary Boolean                @default(true)
  seoTitle         String?
  seoDescription   String?
  deletedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  images           ProductImage[]
  videos           ProductVideo[]
  tags             ProductTag[]
  variants         ProductVariant[]
  prices           Price[]
  inventory        Inventory?
  inventoryTx      InventoryTransaction[]
  promotionLinks   PromotionProduct[]

  @@index([status])
  @@index([environmentId])
  @@index([categoryId])
  @@index([brandId])
  @@index([isFeatured])
  @@index([isBestseller])
  @@index([isNew])
  @@index([createdAt])
  @@index([environmentId, shopCategorySlug])
  @@index([environmentId, variantGroupKey, isVariantPrimary])
  @@index([environmentId, status, isVariantPrimary, deletedAt])
  @@index([environmentId, itemNo])
  @@schema("catalog")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
  @@schema("catalog")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  title     String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId, sortOrder])
  @@schema("catalog")
}

model ProductVideo {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  tag       String?
  sortOrder Int     @default(0)

  @@index([productId])
  @@schema("catalog")
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@schema("catalog")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String   @unique
  name      String
  gtin      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@schema("catalog")
}

model Price {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  amount    Float
  currency  String         @default("QAR")
  type      PriceType
  saleStart DateTime?
  saleEnd   DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  history   PriceHistory[]

  @@index([productId, type])
  @@schema("catalog")
}

enum PriceType {
  REGULAR
  SALE
  @@schema("catalog")
}

model PriceHistory {
  id        String   @id @default(cuid())
  priceId   String
  price     Price    @relation(fields: [priceId], references: [id], onDelete: Cascade)
  oldAmount Float
  newAmount Float
  changedBy String?
  reason    String?
  createdAt DateTime @default(now())
  @@schema("catalog")
}

model Inventory {
  id                String   @id @default(cuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(5)
  isInStock         Boolean  @default(true)
  locationId        String?
  updatedAt         DateTime @updatedAt
  @@schema("catalog")
}

model InventoryTransaction {
  id          String          @id @default(cuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        InventoryTxType
  quantity    Int
  previousQty Int
  newQty      Int
  note        String?
  createdBy   String?
  createdAt   DateTime        @default(now())

  @@index([productId, createdAt])
  @@schema("catalog")
}

enum InventoryTxType {
  SET
  INCREASE
  DECREASE
  ADJUST
  @@schema("catalog")
}

model Promotion {
  id          String             @id @default(cuid())
  name        String
  description String?
  type        String             @default("PERCENTAGE")
  value       Float?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  products    PromotionProduct[]
  @@schema("catalog")
}

model PromotionProduct {
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@schema("catalog")
}

model Banner {
  id            String       @id @default(cuid())
  title         String
  subtitle      String?
  imageUrl      String?
  ctaText       String?
  ctaUrl        String?
  environmentId String?
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  startDate     DateTime?
  endDate       DateTime?
  sortOrder     Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([environmentId])
  @@schema("catalog")
}

model HomepageSection {
  id            String       @id @default(cuid())
  type          String
  title         String?
  subtitle      String?
  config        String       @default("{}")
  environmentId String?
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  sortOrder     Int          @default(0)
  isEnabled     Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([environmentId])
  @@schema("catalog")
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  altText   String?
  title     String?
  mimeType  String?
  fileSize  Int?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  @@schema("catalog")
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  @@schema("catalog")
}

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String?
  heroImage String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@schema("catalog")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  context   String   @default("general")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  @@schema("catalog")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
  @@schema("catalog")
}

model WhatsAppSetting {
  id              String   @id @default(cuid())
  phoneNumber     String
  defaultGreeting String   @default("Hello TFRC team,")
  orderIntro      String   @default("I'd like to place the following order:")
  productTemplate String   @default("{{index}}. {{name}}\n   Ref: {{productId}} | Qty: {{quantity}}\n   {{sizeLine}}{{lineTotal}}")
  closingMessage  String   @default("Please confirm availability and delivery details. Thank you.")
  isActive        Boolean  @default(true)
  updatedAt       DateTime @updatedAt
  @@schema("catalog")
}

model SocialLink {
  id        String  @id @default(cuid())
  platform  String
  url       String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  @@schema("catalog")
}

model DeliverySetting {
  id                    String   @id @default(cuid())
  isAvailable           Boolean  @default(true)
  message               String?
  fee                   Float?
  freeDeliveryThreshold Float?
  deliveryTime          String?
  coverage              String?
  updatedAt             DateTime @updatedAt
  @@schema("catalog")
}

model ImportJob {
  id            String        @id @default(cuid())
  fileName      String
  status        ImportStatus  @default(PENDING)
  totalRows     Int           @default(0)
  validRows     Int           @default(0)
  invalidRows   Int           @default(0)
  created       Int           @default(0)
  updated       Int           @default(0)
  failed        Int           @default(0)
  warnings      Int           @default(0)
  stats         String        @default("{}")
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  environmentId String?
  environment   Environment?  @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  errors        ImportError[]
  createdAt     DateTime      @default(now())
  completedAt   DateTime?

  @@index([environmentId])
  @@schema("catalog")
}

enum ImportStatus {
  PENDING
  PREVIEW
  VALIDATING
  IMPORTING
  COMPLETED
  FAILED
  @@schema("catalog")
}

model ImportError {
  id          String    @id @default(cuid())
  importJobId String
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  row         Int
  field       String?
  message     String
  severity    String    @default("error")
  @@schema("catalog")
}

model CustomerInquiry {
  id              String   @id @default(cuid())
  eventType       String
  sessionId       String?
  customerName    String?
  customerPhone   String?
  environmentSlug String?
  environmentName String?
  pagePath        String?
  referrer        String?
  userAgent       String?
  ipAddress       String?
  city            String?
  region          String?
  country         String?
  timezone        String?
  itemCount       Int      @default(0)
  estimatedTotal  Float?
  currency        String   @default("QAR")
  whatsappMessage String?
  whatsappUrl     String?
  metadata        String?
  createdAt       DateTime @default(now())
  items           CustomerInquiryItem[]

  @@index([createdAt])
  @@index([eventType])
  @@index([sessionId])
  @@index([customerPhone])
  @@index([environmentSlug])
  @@schema("activity")
}

model CustomerInquiryItem {
  id              String          @id @default(cuid())
  inquiryId       String
  inquiry         CustomerInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  productId       String
  productName     String
  slug            String
  price           Float
  quantity        Int             @default(1)
  size            String?
  currency        String          @default("QAR")
  environmentSlug String?
  environmentName String?

  @@index([inquiryId])
  @@index([productId])
  @@schema("activity")
}

/** Admin Report module — Office Forms I.Q.S workflow (isolated from catalogues). */
enum OfficeReportImportStatus {
  PENDING
  READY
  FAILED
  @@schema("activity")
}

model OfficeReportImport {
  id                 String                   @id @default(cuid())
  fileName           String
  fileSize           Int                      @default(0)
  status             OfficeReportImportStatus @default(PENDING)
  errorMessage       String?
  inventorySheetName String?
  imageSheetName     String?
  iqsSheetName       String?
  inventoryHeaders   String                   @default("[]")
  columnMap          String                   @default("{}")
  inventoryRowCount  Int                      @default(0)
  imageLinkCount     Int                      @default(0)
  duplicateItemCodes String                   @default("[]")
  /// Unique item codes to seed into report lines (first/original only).
  uniqueItemCount    Int                      @default(0)
  /// How many unique report lines have been seeded so far (chunked import).
  seedProgress       Int                      @default(0)
  /// JSON map of itemCode → wholesalePriceApproval from the I.Q.S sheet.
  iqsWholesaleByCode String                   @default("{}")
  createdByUserId    String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  inventoryItems     OfficeReportInventoryItem[]
  imageLinks         OfficeReportImageLink[]
  reports            OfficeReport[]

  @@index([createdAt])
  @@index([status])
  @@schema("activity")
}

model OfficeReportInventoryItem {
  id        String             @id @default(cuid())
  importId  String
  import    OfficeReportImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  itemCode  String
  payload   String             @default("{}")
  /// Sheet order for Excel-accurate first-match VLOOKUP behaviour.
  sortOrder Int                @default(0)

  @@index([importId, itemCode, sortOrder])
  @@index([itemCode])
  @@schema("activity")
}

model OfficeReportImageLink {
  id        String             @id @default(cuid())
  importId  String
  import    OfficeReportImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  itemCode  String
  imageUrl  String
  fileName  String?
  /// Sheet order for Excel-accurate first-match VLOOKUP behaviour.
  sortOrder Int                @default(0)

  @@index([importId, itemCode, sortOrder])
  @@schema("activity")
}

model OfficeReport {
  id           String             @id @default(cuid())
  importId     String
  import       OfficeReportImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  title        String             @default("Inventory Availability & Price Check")
  customerName String             @default("")
  requestedBy  String             @default("")
  shopBranch   String             @default("")
  tfrcLabel    String             @default("TFRC")
  notes        String             @default("")
  reportDate   String             @default("")
  createdByUserId String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  lines        OfficeReportLine[]

  @@index([importId])
  @@index([createdAt])
  @@schema("activity")
}

model OfficeReportLine {
  id                      String       @id @default(cuid())
  reportId                String
  report                  OfficeReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sortOrder               Int          @default(0)
  itemCode                String
  imageLink               String       @default("")
  itemName                String       @default("")
  supplierName            String       @default("")
  onHand                  String       @default("")
  itemCost                String       @default("")
  sellingPrice            String       @default("")
  wholesalePriceApproval  String       @default("")
  lookupStatus            String       @default("ok")
  lookupWarning           String?

  @@index([reportId, sortOrder])
  @@index([itemCode])
  @@schema("activity")
}

/** Lightweight storefront analytics beacon (page views, clicks, etc.). */
model StoreEvent {
  id              String   @id @default(cuid())
  eventType       String
  environmentSlug String?
  path            String?
  productId       String?
  sessionId       String?
  metadata        String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([eventType])
  @@index([environmentSlug])
  @@index([sessionId])
  @@schema("activity")
}
